# Build output
build/
build-setupui/
build-tests/

# The engine's build output (and the install step's copy of it), plus what the build fetches
# rather than the repository carries: Autodesk's FBX SDK and the community listfile (~150 MB).
engine/build*/
engine/bin/
engine/ThirdParty/fbx_x64/
engine/bin_support/wow/listfile.csv

# Local build logs and traces. The phase history lives in the commit messages.
build-log.txt
phase*-trace.txt
*.log

# Phase screenshots -- large, and only meaningful next to their commit.
# (resources/ is exempt: the splash and icon ship with the app.)
*.png
!resources/*.png

# Editor / OS noise
*.bak
.vs/

# Release artefacts. stage.ps1 rebuilds the payload, ISCC rebuilds the setup.
# The wildcards matter: a previous release moved aside as dist-alt-<date> fell straight out
# of "installer/dist/" and a git add -A swept 180 MB of build output into a commit, which the
# remote then refused. Anything named like the staging or output folder stays out.
installer/stage*/
installer/dist*/
installer/setupui-stage/

# Runtime data written beside the executable: settings with the player's WoW path, the log
# and trace, the database cache, the look library and the NPC thumbnails. Personal and
# machine-specific -- it belongs to the installation, never to the repository.
userSettings/
