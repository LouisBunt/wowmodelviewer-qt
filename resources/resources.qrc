<RCC>
  <qresource prefix="/">
    <file>splash.png</file>
    <file>appicon.png</file>
  </qresource>
  <qresource prefix="/fonts">
    <file alias="Inter-Regular.ttf">fonts/Inter-Regular.ttf</file>
    <file alias="Inter-Medium.ttf">fonts/Inter-Medium.ttf</file>
    <file alias="Inter-SemiBold.ttf">fonts/Inter-SemiBold.ttf</file>
    <file alias="IBMPlexMono-Regular.ttf">fonts/IBMPlexMono-Regular.ttf</file>
    <file alias="Cinzel-Regular.ttf">fonts/Cinzel-Regular.ttf</file>
  </qresource>
  <qresource prefix="/icons">
    <file alias="box.svg">icons/box.svg</file>
    <file alias="camera.svg">icons/camera.svg</file>
    <file alias="check.svg">icons/check.svg</file>
    <file alias="chevron-down.svg">icons/chevron-down.svg</file>
    <file alias="chevron-left.svg">icons/chevron-left.svg</file>
    <file alias="chevron-right.svg">icons/chevron-right.svg</file>
    <file alias="chevron-up.svg">icons/chevron-up.svg</file>
    <file alias="circle-dot.svg">icons/circle-dot.svg</file>
    <file alias="eye-off.svg">icons/eye-off.svg</file>
    <file alias="eye.svg">icons/eye.svg</file>
    <file alias="folder.svg">icons/folder.svg</file>
    <file alias="grid-3x3.svg">icons/grid-3x3.svg</file>
    <file alias="info.svg">icons/info.svg</file>
    <file alias="layers.svg">icons/layers.svg</file>
    <file alias="maximize-2.svg">icons/maximize-2.svg</file>
    <file alias="minus.svg">icons/minus.svg</file>
    <file alias="package.svg">icons/package.svg</file>
    <file alias="palette.svg">icons/palette.svg</file>
    <file alias="pause.svg">icons/pause.svg</file>
    <file alias="paw-print.svg">icons/paw-print.svg</file>
    <file alias="play.svg">icons/play.svg</file>
    <file alias="refresh-cw.svg">icons/refresh-cw.svg</file>
    <file alias="search.svg">icons/search.svg</file>
    <file alias="skip-back.svg">icons/skip-back.svg</file>
    <file alias="skip-forward.svg">icons/skip-forward.svg</file>
    <file alias="square.svg">icons/square.svg</file>
    <file alias="sun.svg">icons/sun.svg</file>
    <file alias="swords.svg">icons/swords.svg</file>
    <file alias="triangle-alert.svg">icons/triangle-alert.svg</file>
    <file alias="user.svg">icons/user.svg</file>
    <file alias="users.svg">icons/users.svg</file>
    <file alias="x.svg">icons/x.svg</file>
  </qresource>
</RCC>
